# =============================================================================
# Classora — environment template  (copy to `.env.local` and fill in)
#
# IMPORTANT
#  - Only VITE_* variables are exposed to the browser bundle.
#  - Never put a secret in a VITE_* variable.
#  - Server-only secrets (AI_API_KEY, VAPID_PRIVATE_KEY, SUPABASE_SERVICE_ROLE_KEY)
#    must be set in your serverless/edge runtime, NOT in a VITE_ var.
# =============================================================================

# -----------------------------------------------------------------------------
# MODE
# -----------------------------------------------------------------------------
# `local`  -> Demo / offline mode (IndexedDB via Dexie). No credentials required.
# `cloud`  -> Supabase mode (Auth + Postgres + Storage).
# If Supabase variables below are absent, Classora automatically falls back to
# local mode, so the app always runs.
VITE_APP_MODE=local

# -----------------------------------------------------------------------------
# CLOUD MODE — Supabase (public, safe-to-ship values only)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY (never expose to the client bundle, never prefix with VITE_)
# -----------------------------------------------------------------------------
# Multimodal AI used for timetable extraction (PDF / image -> structured JSON)
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Supabase server-side key for privileged operations (RLS bypass) — server only
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Public key may be shipped; private key must stay server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
